  },
  {
   "id": "b11_005",
   "off": "0x008F",
   "op": "01",
   "uid": "a2320b02de",
   "text": "「[c1][FD0F:0A][c0]は　だれ　かまわず　おそうようだ[n]　きみたちも　きをつけたまえ。[LINE]"
  },
  {
   "id": "b11_006",
   "off": "0x00BF",
   "op": "01",
   "uid": "499608c97b",
   "text": "「北にゆくと　[c2][FD0E:22][c0]の　村だよ。[LINE]"
  },
  {
   "id": "b11_007",
   "off": "0x00D8",
   "op": "01",
   "uid": "89b2f4149e",
   "text": "「[END]"
  },
  {
   "id": "b11_008",
   "off": "0x00DE",
   "op": "01",
   "uid": "e6d9ff8b54",
   "text": "きのうも　[c1][FD0F:0A][c0]に　おそわれた人がい[FD0F:39][LINE]"
  },
  {
   "id": "b11_009",
   "off": "0x00FC",
   "op": "01",
   "uid": "6fc74e14c3",
   "text": "[c2][FD0E:0C][c0]には[n]　ちかずいちゃ　だめなんだってさ!![LINE]"
  },
  {
   "id": "b11_010",
   "off": "0x0120",
   "op": "01",
   "uid": "320d0df99c",
   "text": "「な-　な-!　あんちゃん!![n]　おいらに　なんか　めぐんでくれよ-!![LINE]"
  },
  {
   "id": "b11_011",
   "off": "0x014B",
   "op": "01",
   "uid": "b95d5ef278",
   "text": "「・・・おかあさんが　しらない人と[n]　はなしちゃだめだって。[LINE]"
  },
  {
   "id": "b11_012",
   "off": "0x0184",
   "op": "01",
   "uid": "719cebe4f2",
   "text": "[wait][n]「[c1]村長[c0]のおかげで　この村も　さいきんは　かなり[n]　くらしやすくなっていたんだが[n]　[c1][FD0F:0A][c0]どものおかげで　さんざんだよ。[LINE]"
  },
  {
   "id": "b11_013",
   "off": "0x01DA",
   "op": "01",
   "uid": "e122fb0c63",
   "text": "「村のまもりは　まかせてくれ!![LINE]"
  },
  {
   "id": "b11_014",
   "off": "0x01EE",
   "op": "01",
   "uid": "2b8d8f2f63",
   "text": "「いまのところ　とくに　いじょうはないぞ!![LINE]"
  },
  {
   "id": "b11_015",
   "off": "0x020A",
   "op": "01",
   "uid": "5978700064",
   "text": "「[c2][FD0E:0C][c0]は　村の　北の山の中だ!![LINE]"
  },
  {
   "id": "b11_016",
   "off": "0x0228",
   "op": "01",
   "uid": "f26744dad5",
   "text": "「ここは　[c2][FD0E:03][c0]です。[END]"
